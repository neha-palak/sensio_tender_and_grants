# Point these at the SAME shared Drive folders the existing Tender Tool and
# Grants (CFP) Tool already use — no data migration needed, the scrapers keep
# writing there unchanged.
TENDER_DATA_DIR=/path/to/Sensio Tender Tool
GRANT_DATA_DIR=/path/to/Sensio Grants Tool

# Optional: change the port the merged dashboard listens on (default 5001).
# SENSIO_DASHBOARD_PORT=5001
