# Supabase Postgres connection string. Use the SESSION POOLER string, not the
# direct connection -- Render's network doesn't reliably reach Supabase's
# direct/IPv6 endpoint (same issue hit in Production_Log). Find it in the
# Supabase dashboard: Project Settings -> Database -> Connection string ->
# "Session pooler".
DATABASE_URL=postgresql://postgres.xxxxxxxx:password@aws-0-REGION.pooler.supabase.com:5432/postgres

# Optional: change the port the dashboard listens on when run locally via
# desktop_app.py (default 5001). Render sets its own $PORT; see Procfile.
# SENSIO_DASHBOARD_PORT=5001
